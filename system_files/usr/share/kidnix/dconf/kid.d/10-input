# kidnix child session: pointer, keyboard and presentation defaults.
#
# Straight out of docs/research/06-input-accessibility-hardware-ai.md §7.1
# (numbered specs 1, 4, 5, 6, 8, 9, 10) and §7.3 (spec 21). GNOME 50 moved the
# pointer keys from org.gnome.settings-daemon.peripherals.mouse to
# org.gnome.desktop.peripherals.mouse -- verified in this image with
# `gsettings list-keys org.gnome.desktop.peripherals.mouse`.
#
# These are LOCKED (see locks/10-input) rather than merely defaulted, because
# an activity that "helpfully" restores the adult default would undo the one
# accessibility change with the best evidence behind it.

[org/gnome/desktop/peripherals/mouse]
# Spec 1: 700 ms, up from GNOME's 400 ms. Children's spontaneous inter-tap
# interval is 400-500 ms with high variability, so the stock default sits right
# at the edge of what a 5-year-old can reliably produce.
double-click=700
# Spec 5: 16 px, up from 8, so a wobbly click is not misread as a drag.
drag-threshold=16
# Spec 4: keep the flat (1:1) profile. Acceleration curves punish the many
# small corrective sub-movements children actually make.
accel-profile='flat'
# Spec 4: -0.4, slower than GNOME's -0.241 default. Parent-adjustable later.
speed=-0.4
# Never invent a middle button a child did not press.
middle-click-emulation=false
# Natural scroll left at the GNOME default on purpose: research 06 has no
# finding either way, and changing it would be a taste call in a file that is
# meant to carry only evidence.

# The whole [org/gnome/desktop/peripherals/touchpad] block moved to
# 11-trackpad. 09 Q7 turns tap-to-click and both scroll methods OFF, which is
# a different (and later) finding from 06 spec 6, and the trackpad now needs
# enough explanation to deserve its own file. Setting a key in two keyfiles is
# a build failure, so it lives in exactly one.

[org/gnome/desktop/a11y/mouse]
# Spec 8: dwell click available with a much more forgiving threshold. Left
# DISABLED by default -- it is a parent-enabled accommodation, not a surprise.
dwell-click-enabled=false
dwell-time=1.2
dwell-threshold=20
secondary-click-enabled=false

[org/gnome/desktop/interface]
# Spec 9: 48 px, double the GNOME default of 24.
cursor-size=48
# Spec 17: nothing a child needs lives in a screen corner.
enable-hot-corners=false
# Spec 21: default text scaling 1.3. Full 0.5-3.0 range stays available to a
# parent (this key is a default, not a lock -- see locks/10-input).
text-scaling-factor=1.3
# Spec 27 says motion must be short and eased, not absent. Animations stay on;
# the shell honours enable-animations=false if a parent turns it off.
enable-animations=true
# Middle-click paste is invisible, undoable-by-accident magic.
gtk-enable-primary-paste=false
# Accessibility bus on, so Orca / dogtail / the test suite can see the tree.
toolkit-accessibility=true

[org/gnome/desktop/peripherals/keyboard]
# Spec 10: a stuck key must not fill a story with 400 letters. 1000 ms before
# the first repeat, and a slow repeat after that.
repeat=true
delay=uint32 1000
repeat-interval=uint32 80

[org/gnome/desktop/a11y/keyboard]
# Sticky/slow/bounce keys are parent-enabled accommodations, never defaults,
# and must never be switchable by mashing Shift five times -- that is exactly
# what a 5-year-old does.
enable=false
stickykeys-enable=false
stickykeys-two-key-off=false
stickykeys-modifier-beep=false
slowkeys-enable=false
bouncekeys-enable=false
mousekeys-enable=false

[org/gnome/desktop/wm/preferences]
# Focus follows nothing: the fullscreen activity always has focus.
focus-mode='click'
auto-raise=false
# One workspace. There is nowhere else to go.
num-workspaces=1

[org/gnome/desktop/input-sources]
# UK keyboard, and only UK. The child's session overrides the system layout
# (/etc/X11/xorg.conf.d/00-keyboard.conf) the moment GNOME starts, so setting
# it there and not here would leave the child on the compiled-in `us` default:
# the @ and " keys swapped from the ones printed on the keycaps, and no £ at
# all. Locked (locks/10-input) because a one-entry list is also the only way
# to guarantee there is no layout switcher to land on by accident -- GNOME
# shows the input-source indicator and binds Super+Space only when there is
# more than one source.
sources=[('xkb', 'gb')]
# No dead keys, no compose, no "swap Ctrl and Caps": every xkb option is a way
# for a keyboard to stop behaving the way its keycaps say it does.
xkb-options=@as []
# One layout for the whole session, not one per window.
per-window=false
