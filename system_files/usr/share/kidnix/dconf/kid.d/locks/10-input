# Input settings the child session may not change.
#
# text-scaling-factor and cursor-theme are deliberately NOT locked: they are
# the two knobs a parent is most likely to want to turn for a specific child,
# and a locked key cannot be changed even by the parent panel acting on the
# child's behalf. cursor-size IS locked -- 48 px is the evidence-backed floor,
# not a preference.

/org/gnome/desktop/peripherals/mouse/double-click
/org/gnome/desktop/peripherals/mouse/drag-threshold
/org/gnome/desktop/peripherals/mouse/accel-profile
/org/gnome/desktop/peripherals/mouse/middle-click-emulation

# The touchpad locks moved to locks/11-trackpad, with the keys.

/org/gnome/desktop/interface/cursor-size
/org/gnome/desktop/interface/enable-hot-corners
/org/gnome/desktop/interface/gtk-enable-primary-paste
/org/gnome/desktop/interface/toolkit-accessibility

/org/gnome/desktop/a11y/keyboard/stickykeys-two-key-off

/org/gnome/desktop/wm/preferences/num-workspaces

# The keyboard layout. A five-year-old copying a letter from a book must get
# the character printed on the key; there is no reading-age-appropriate way to
# discover that the layout has been changed, or to change it back.
/org/gnome/desktop/input-sources/sources
/org/gnome/desktop/input-sources/xkb-options
/org/gnome/desktop/input-sources/per-window
