#!/usr/bin/bash
# kidnix kiosk session -- what GDM execs for the `kid` user.
#
# This is a *wrapper around gnome-session*, not the shell itself. The chain is:
#
#   GDM  ->  /usr/share/wayland-sessions/kidnix-shell.desktop
#        ->  /usr/bin/kidnix-shell            (this file: environment only)
#        ->  gnome-session --session=kidnix
#        ->  gnome-session@kidnix.target
#              +-- org.gnome.Kiosk.target  -> gnome-kiosk (the compositor)
#              +-- kidnix-shell.service    -> /usr/bin/kidnix-shell-app
#
# WHY gnome-session AT ALL, when v0.1 just exec'd gnome-kiosk directly:
# xdg-desktop-portal.service and both its backends carry
# `Requisite=graphical-session.target`, and `Requisite=` fails immediately
# unless the target is *already active*. Only gnome-session raises
# graphical-session.target (gnome-session.target BindsTo= it), so without
# gnome-session the child's session has no portals -- no file chooser, no
# screenshot, no Flatpak that needs one. gnome-kiosk's own units say the same
# thing from the other side: org.gnome.Kiosk.target is
# `Requisite=gnome-session-initialized.target`, so it cannot even start outside
# a gnome-session. See docs/spikes/session-integration.md.
#
# Everything this script does is environment. The session's *structure* lives
# in /usr/share/gnome-session/sessions/kidnix.session and
# /usr/lib/systemd/user/gnome-session@kidnix.target.d/session.conf, where
# systemd and gnome-session can both see it.
set -euo pipefail

# Skip GNOME's first-run wizard; a 4-year-old cannot complete it.
mkdir -p "${HOME}/.config"
: >"${HOME}/.config/gnome-initial-setup-done"

# --- lockdown (see docs/spikes/lockdown.md) ----------------------------------

# Select the child's dconf profile (/etc/dconf/profile/kid), which layers the
# locked kidnix defaults under the user's own database. dconf reads this at
# process start, so it must be exported BEFORE anything in the session runs.
#
# It has to be done HERE and not in /usr/lib/environment.d/, because
# environment.d applies to *every* user's systemd manager on the machine and
# the parent must keep stock GNOME defaults (ADR-0005). A wrapper that only
# the kid session executes is the narrowest place this can live.
export DCONF_PROFILE=kid

# Almost everything in the session -- gnome-kiosk, the shell, the portals, the
# gsd helpers -- is started by `systemd --user` or dbus activation, not as a
# child of this script, so exporting is not enough. pam_systemd started the
# user manager before GDM ever exec'd us, so both of these work here, and both
# must happen before gnome-session starts anything.
#
# gnome-session does upload its own environment to systemd and D-Bus as it
# starts, so this is belt-and-braces; neither failing is fatal (the cost is the
# locked defaults, not the session).
if command -v systemctl >/dev/null 2>&1; then
    systemctl --user set-environment DCONF_PROFILE=kid || true
fi
if command -v dbus-update-activation-environment >/dev/null 2>&1; then
    dbus-update-activation-environment --systemd DCONF_PROFILE || true
fi

# --- hand over ---------------------------------------------------------------

# `--session=kidnix` names /usr/share/gnome-session/sessions/kidnix.session,
# which in turn names the systemd target gnome-session@kidnix.target.
exec /usr/bin/gnome-session --session=kidnix
